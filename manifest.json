{
  "manifest_version": 3,
  "name": "Copy HTML to Markdown",
  "version": "1.0",
  "description": "Copies selected HTML content and converts it to Markdown.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copy as Markdown"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/turndown.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
